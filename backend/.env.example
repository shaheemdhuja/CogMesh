# Application Configuration
PROJECT_NAME="CogMesh Distributed Runtime"
VERSION="0.1.0"
DEBUG=true
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Database Configuration (SQLite with AsyncIO)
DATABASE_URL="sqlite+aiosqlite:///./cogmesh.db"

# Logging Configuration
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/cogmesh.log"
LOG_RETENTION="10 days"
LOG_ROTATION="10 MB"

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=["*"]
